# No verified PONS test deployment has been identified. Mainnet writes are opt-in.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_ENABLE_MAINNET=false
NEXT_PUBLIC_FORGE_ROUTER_FACTORY=0x556be53ccf6a6427730315af23eaca4344e0b8ca
NEXT_PUBLIC_FORGE_DEPLOYMENT_BLOCK=62814079
NEXT_PUBLIC_PONS_LAUNCH_CONTRACT=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
NEXT_PUBLIC_PONS_NETWORK=Robinhood Chain
NEXT_PUBLIC_PONS_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
PINATA_JWT=
APP_ORIGIN=http://localhost:3000
# Generate with a cryptographic random generator, at least 32 characters.
UPLOAD_SESSION_SECRET=
INDEXER_DATA_DIR=./data
INDEXER_CONFIRMATIONS=12
# Deployment only; never put a funded private key in browser/public variables.
DEPLOYER_PRIVATE_KEY=
# Explicit one-shot infrastructure deployment guard. This is separate from frontend writes.
DEPLOY_FORGE_MAINNET=false
PONS_FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e

# Versioned V2 registry. Keep the legacy registry above for historical reads.
NEXT_PUBLIC_FORGE_ROUTER_FACTORY_V2=
NEXT_PUBLIC_FORGE_DEPLOYMENT_BLOCK_V2=
NEXT_PUBLIC_FORGE_AUTOMATION_EXECUTOR=
# Public signer address and local encrypted Foundry account name (never a secret).
FORGE_V2_DEPLOYER=
FORGE_V2_KEYSTORE_ACCOUNT=
DEPLOY_FORGE_V2_MAINNET=false
# Shared automation keeper. It is reimbursed from each router's creator-funded gas balance.
FORGE_AUTOMATION_KEEPER_ADDRESS=
# Standalone keeper: monitoring only unless both env and --execute are supplied.
FORGE_DCA_KEEPER_EXECUTE=false
FORGE_DCA_KEEPER_RPC_URL=
FORGE_DCA_KEEPER_ADDRESS=
# Server secret for the shared gas-only wallet. Never use a creator or treasury wallet.
FORGE_DCA_KEEPER_PRIVATE_KEY=
